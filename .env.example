# MasterNode frontend — copy to frontend/.env.local and fill in secrets.

# FastAPI base URL. Comma-separated list is allowed: local first, remote fallback.
# The app probes `/health` and uses the first origin that is MasterNode FastAPI.
# Dev: http://localhost:8000  |  fallback: https://masternode.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
# Local production build with localhost API: npm run build:local

# Browser calls use /api/backend (Next.js proxy → NEXT_PUBLIC_API_URL) to avoid CORS. Set to 0 to call the API directly.
# NEXT_PUBLIC_USE_API_PROXY=0

# Block right-click / devtools shortcuts. Set to 0 locally when you need inspect.
# NEXT_PUBLIC_DISABLE_INSPECT=0

# Razorpay Standard Checkout — PUBLIC key id only (never the KEY_SECRET).
# Must match RAZORPAY_KEY_ID in backend/.env.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_T8y2X9oaLFbeJs

# Server-only: signed session cookie + middleware (openssl rand -base64 32)
AUTH_SESSION_SECRET=

# Auth.js (OAuth) — reuse AUTH_SESSION_SECRET as AUTH_SECRET if unset
# AUTH_SECRET=
# Generate with: openssl rand -base64 32

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/oauth/callback/google
# Production: https://your-domain.com/api/oauth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=0

# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/oauth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=0

# Microsoft Entra ID — https://portal.azure.com → App registrations
# Redirect URI: http://localhost:3000/api/oauth/callback/microsoft
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
NEXT_PUBLIC_OAUTH_MICROSOFT_ENABLED=0

# Apple Sign In — https://developer.apple.com/account/resources/identifiers/list/serviceId
# Return URL: https://your-domain.com/api/oauth/callback/apple (HTTPS required; no localhost)
# AUTH_APPLE_SECRET is a JWT — see https://authjs.dev/getting-started/providers/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
NEXT_PUBLIC_OAUTH_APPLE_ENABLED=0

# Optional: server-to-server secret for /v1/auth/oauth and password-reset BFF
# (defaults to AUTH_SESSION_SECRET). Must match the backend OAUTH_BRIDGE_SECRET
# or AUTH_SESSION_SECRET so forgot-password can receive the reset token to email.
# OAUTH_BRIDGE_SECRET=

# --- Email OTP verification (Gmail SMTP + database) ---
# Gmail App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pi.masternode@gmail.com
SMTP_PASSWORD=
SMTP_FROM=MasterNode <you@gmail.com>

# OTP storage — pick ONE backend (required on Vercel Production too):
#
# Option A: Neon PostgreSQL (apply frontend/db/migrations/0001_email_otps.sql once)
# DATABASE_URL=postgresql://user:pass@ep-xxxx.aws.neon.tech/neondb?sslmode=require
#
# Option B: MongoDB Atlas (reuses your existing backend cluster; no SQL migration)
MONGODB_URL=
MONGODB_DB_NAME=demo_db

# Optional dedicated secret to key the OTP hash (defaults to AUTH_SESSION_SECRET).
# OTP_HASH_SECRET=

# Local dev only: echo OTP on screen instead of emailing (never enable in prod / Vercel).
# OTP_DEV_ECHO=1

# Optional: social links in footer
# NEXT_PUBLIC_SOCIAL_GITHUB=
# NEXT_PUBLIC_SOCIAL_TWITTER=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
